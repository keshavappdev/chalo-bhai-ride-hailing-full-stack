# Flutter uses --dart-define instead of committing secrets.
# Example:
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:4000/api --dart-define=SOCKET_URL=http://10.0.2.2:4000
API_BASE_URL=http://10.0.2.2:4000/api
SOCKET_URL=http://10.0.2.2:4000
GOOGLE_MAPS_API_KEY=put-key-in-native-platform-config-not-dart
