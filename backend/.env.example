# Copy to .env locally; never commit .env or live credentials.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ride_hailing
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FARE_BASE=50
FARE_PER_KM=12
FARE_PER_MINUTE=2
FARE_MINIMUM=80
DRIVER_SEARCH_RADIUS_METERS=7000
# Only required when executing the admin seed script. Set your own values locally.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YOUR_UNIQUE_ADMIN_PASSWORD_AT_LEAST_10_CHARACTERS
